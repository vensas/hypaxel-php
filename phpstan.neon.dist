includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: max
    tmpDir: .phpstan.cache
    # The public API validates what callers pass at runtime, whatever the PHPDoc promises.
    treatPhpDocTypesAsCertain: false
    strictRules:
        # Records are read by property name: $record->{$key}.
        noVariableVariables: false
    paths:
        - src
        - tests
        - benchmarks
        - examples
    phpVersion:
        min: 80200
        max: 80599
