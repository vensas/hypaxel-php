{
  "id": "php-jit",
  "language": "php",
  "title": "PHP: opcache with tracing JIT",
  "dataset": "10 columns per row: integers, strings (one unique per row), floats, a date/time and a boolean, from a generator to a file. Each case runs in its own process",
  "method": "Single runs while the machine was busy with other work. Peak memory is memory_get_peak_usage(true), including the autoloader and the library's classes.",
  "environment": {
    "hardware": "Apple M1 Max",
    "os": "macOS 26.6",
    "runtime": "PHP 8.4.8 (CLI, NTS), opcache.enable_cli=1, opcache.jit=tracing, opcache.jit_buffer_size=128M"
  },
  "versions": [
    "OpenSpout 5.14.1",
    "PhpSpreadsheet 5.11.0"
  ],
  "metrics": [
    {
      "id": "t100k",
      "label": "100k rows",
      "unit": "s",
      "lowerIsBetter": true
    },
    {
      "id": "mem100k",
      "label": "Peak memory (100k)",
      "unit": "MB",
      "lowerIsBetter": true,
      "memoryKind": "peakHeap"
    },
    {
      "id": "t1m",
      "label": "1M rows",
      "unit": "s",
      "lowerIsBetter": true
    },
    {
      "id": "mem1m",
      "label": "Peak memory (1M)",
      "unit": "MB",
      "lowerIsBetter": true,
      "memoryKind": "peakHeap"
    }
  ],
